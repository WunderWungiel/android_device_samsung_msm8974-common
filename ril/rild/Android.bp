// rild built against the Samsung libril and RIL headers. rild.c and rild.rc
// are unmodified copies from hardware/ril/rild. The stock "rild" module is
// disabled when the board sets ENABLE_VENDOR_RIL_SERVICE := true (klte-common).
cc_binary {
    name: "rild_samsung",
    stem: "rild",
    srcs: ["rild.c"],
    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
        "libril_samsung",
    ],
    // Temporary hack for broken vendor RILs (same as stock rild).
    whole_static_libs: ["librilutils"],
    cflags: [
        "-DRIL_SHLIB",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-DPRODUCT_COMPATIBLE_PROPERTY",
    ] + select(soong_config_variable("ril", "sim_count"), {
        "2": [
            "-DANDROID_MULTI_SIM",
            "-DANDROID_SIM_COUNT_2",
        ],
        default: [],
    }),
    relative_install_path: "hw",
    proprietary: true,
    init_rc: ["rild.rc"],
}
