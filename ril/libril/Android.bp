// Samsung libril (Samsung RIL ABI, see ../include/telephony/ril.h).
//
// hardware/ril provides a global Soong "libril" that cannot be disabled, so
// this one gets its own module name. stem keeps the installed file as
// /vendor/lib/libril.so, which libsec-ril.so links against (DT_NEEDED).
// build/make/target/product/base_vendor.mk adds the stock libril to every
// product, so this one overrides it.
cc_library_shared {
    name: "libril_samsung",
    stem: "libril",
    overrides: ["libril"],
    vendor: true,
    srcs: [
        "ril.cpp",
        "ril_event.cpp",
        "RilSapSocket.cpp",
        "ril_service.cpp",
        "sap_service.cpp",
    ],
    shared_libs: [
        "android.hardware.radio@1.0",
        "android.hardware.radio@1.1",
        "android.hardware.radio.deprecated@1.0",
        "libcutils",
        "libhardware_legacy",
        "libhidlbase",
        "liblog",
        "librilutils",
        "libutils",
    ],
    static_libs: ["libprotobuf-c-nano-enable_malloc-32bit"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Werror",
        "-DPB_FIELD_32BIT",
    ] + select(soong_config_variable("ril", "sim_count"), {
        "2": [
            "-DANDROID_MULTI_SIM",
            "-DDSDA_RILD1",
            "-DANDROID_SIM_COUNT_2",
        ],
        default: [],
    }) + select(soong_config_variable("ril", "disable_rild_oem_hook"), {
        true: ["-DOEM_HOOK_DISABLED"],
        default: [],
    }),
    include_dirs: ["external/nanopb-c"],
    header_libs: ["libril_samsung_headers"],
    export_header_lib_headers: ["libril_samsung_headers"],
    sanitize: {
        misc_undefined: ["integer"],
    },
}
